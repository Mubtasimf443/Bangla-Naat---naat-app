# Public base URL of this API (used to build the links sent in emails)
APP_URL=http://localhost:3000

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=


JWT_SECRET=
JWT_EXPIRES_IN=

# Brevo (https://app.brevo.com -> SMTP & API -> API Keys)
BREVO_API_KEY=
# Must be a verified sender in your Brevo account
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=

# First admin account, created automatically on startup if it does not exist
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
